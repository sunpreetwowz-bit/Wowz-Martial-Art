APP_NAME="Wowz Martial Art"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# .env only stores connection settings — create the MySQL database yourself first:
#   mysql -u root -e "CREATE DATABASE IF NOT EXISTS wowzmartialart CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#   php artisan migrate --seed
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wowzmartialart
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

ADMIN_NAME="Academy Admin"
ADMIN_EMAIL=admin@wowzmartialart.test
ADMIN_PASSWORD=password

ACADEMY_NAME="Wowz Martial Art"
ACADEMY_NOTIFY_MAIL=false
ACADEMY_DEADLINE_NOTIFY_HOURS=24
CERTIFICATE_PREFIX=CERT
STUDENT_CODE_PREFIX=WMA
BELT_TEST_CLOSE_MINUTES=30

# Optional HMAC secret for /payments/callback (payment_uuid|status|transaction_id)
PAYMENT_CALLBACK_SECRET=
