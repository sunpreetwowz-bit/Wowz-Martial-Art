<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block Laravel private storage only (NOT /storage media URLs)
    RewriteRule ^storage/(app|framework|logs)(/|$) - [F,L]

    # Block other sensitive folders
    RewriteRule ^(app|bootstrap|config|database|node_modules|resources|routes|tests|vendor)(/|$) - [F,L]
    RewriteRule ^(\.env|\.git|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js)(/|$) - [F,L]

    # Already inside /public — do nothing
    RewriteRule ^public/ - [L]

    # Send everything else into /public (including /storage → public/storage)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

DirectoryIndex index.php public/index.php
